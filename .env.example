# Copy to .env (never commit real values).

# Public URL of the app. Magic links and cookies are built from it.
BETTER_AUTH_URL=http://localhost:5173
# adapter-node needs ORIGIN in production (same value as BETTER_AUTH_URL).
ORIGIN=http://localhost:5173
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Magic-link email. Without the key the link is printed in the server log.
RESEND_API_KEY=
EMAIL_FROM="WOK <login@wok.eduardotorres.dev>"

# Agents (claude-sonnet-5-5).
ANTHROPIC_API_KEY=

# LinkedIn + Glassdoor collection. Without it the feed is seeded with mock jobs.
APIFY_TOKEN=

# SQLite file, compiled PDFs and per-user browser profiles live here.
DATA_DIR=./data

# Optional: absolute path to the tectonic binary (default: `tectonic` in PATH).
TECTONIC_BIN=

# adapter-node
PORT=3000
HOST=127.0.0.1

# Postings older than this many days are not collected (default 14).
JOBS_MAX_AGE_DAYS=14

# Rehearsal: the applier fills everything but stops before the final submit.
# APPLY_DRY_RUN=1 applies to every user (development only).
APPLY_DRY_RUN=
# Comma-separated account emails that rehearse while everyone else really applies.
APPLY_DRY_RUN_EMAILS=

# Glassdoor's own flow stops at a human check: manual (default) tailors the résumé and
# hands the application to the person; auto lets the applier try the site.
GLASSDOOR_APPLY=manual

# Directory with pdflatex/xelatex/lualatex/tlmgr. Default: ~/.TinyTeX/bin/<arch>, then PATH.
# Every compile runs inside bubblewrap (bwrap must be installed); tectonic is only a reserve.
LATEX_BIN_DIR=

# Optional, comma-separated. When set, only these addresses can sign in; others get the
# same generic answer and no email. Empty: sign-up is open.
AUTH_ALLOWED_EMAILS=
