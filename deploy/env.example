# Modelo de /home/admin/wok/shared/.env (fora do git, chmod 600).
NODE_ENV=production
HOST=127.0.0.1
PORT=3300
ORIGIN=https://wok.eduardotorres.dev
ADDRESS_HEADER=cf-connecting-ip
DATA_DIR=/home/admin/wok-data
BETTER_AUTH_URL=https://wok.eduardotorres.dev
BETTER_AUTH_SECRET=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="Wok <login@wok.eduardotorres.dev>"
APIFY_TOKEN=
# Emails cujas inscrições rodam em modo de ensaio (não enviam candidatura real).
APPLY_DRY_RUN_EMAILS=
# pdfLaTeX do TinyTeX em espaço de usuário (ver README).
LATEX_BIN_DIR=/home/admin/.TinyTeX/bin/x86_64-linux
